# NovaChat Frontend — Production Environment Template
# Copy this to .env.production and fill in your deployed backend URL.
# Do NOT commit this file with real values.

# Replace with your actual deployed backend URL, e.g. Render, Railway, VPS:
VITE_API_URL=https://your-backend-domain.com/api
VITE_SOCKET_URL=https://your-backend-domain.com
VITE_UPLOADS_URL=https://your-backend-domain.com
