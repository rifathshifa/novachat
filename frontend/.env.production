# NovaChat Frontend — Production Environment
# Used during `npm run build`. Uses relative URLs because Flask serves both
# the API and the built frontend from the same origin (same Render service).
# For local dev, .env (with localhost URLs) takes precedence.

# Backend API base URL (same origin, relative path)
VITE_API_URL=/api

# Backend Socket.IO URL (empty = same origin as the page)
VITE_SOCKET_URL=

# Backend uploads/media base URL (empty = same origin as the page)
VITE_UPLOADS_URL=
