# NovaChat Frontend — Local Development Environment
# These vars are embedded at build time by Vite.
# NEVER commit secrets to this file.

# Backend API base URL (no trailing slash)
VITE_API_URL=http://localhost:5000/api

# Backend Socket.IO URL (just origin, no path)
VITE_SOCKET_URL=http://localhost:5000

# Backend uploads/media base URL (no trailing slash)
VITE_UPLOADS_URL=http://localhost:5000
