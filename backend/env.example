# Secret Keys for JWT & Session encryption
SECRET_KEY=dev_secret_key_nova_chat_12345
JWT_SECRET_KEY=jwt_dev_secret_key_nova_chat_abcde

# Database Configuration
# Default is local SQLite. For production, use Neon PostgreSQL:
# DATABASE_URL=postgresql://user:password@ep-xxx.us-east-2.aws.neon.tech/novachat?sslmode=require
# DATABASE_URL=sqlite:///novachat.db
# DATABASE_URL=mysql+pymysql://username:password@localhost:3306/novachat_db

# Frontend URL (for password reset links, etc.)
# In dev: http://localhost:5173
# In production: https://your-app.onrender.com
FRONTEND_URL=http://localhost:5173

# Security Headers (True in Production, False in Dev)
JWT_COOKIE_SECURE=False

# CORS Allowed Origins (comma-separated or *)
# In dev with separate frontend: http://localhost:5173,http://127.0.0.1:5173
# In production same-origin (Flask serves frontend): * works fine
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5176,http://127.0.0.1:5176
